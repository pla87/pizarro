# ---------------------------------------------------------------------------
# Variables de entorno de Pizarro. Copia este fichero a .env para desarrollo.
# NUNCA subas el .env real al repositorio.
# ---------------------------------------------------------------------------

# Cadena de conexión a PostgreSQL. En Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/tablon"

# Secreto para firmar los identificadores de sesión (mínimo 32 caracteres).
# Genera uno con:  openssl rand -base64 48
SESSION_SECRET=""

# URL pública de la app. Si empieza por https:// la cookie se marca Secure.
APP_URL="http://localhost:3000"

# Carpeta de subidas. En Docker/Railway: /app/uploads (montada como volumen).
UPLOAD_DIR="./uploads"

# Puerto HTTP (Railway lo inyecta automáticamente).
PORT=3000

# Administrador inicial: solo se usa si la base de datos no tiene usuarios.
# Tras el primer arranque puedes borrar estas variables.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"

# --- Opcionales ---
# MAX_USERS=5               # Máximo de usuarios activos
# MAX_UPLOAD_MB=10          # Tamaño máximo por imagen
# DATABASE_POOL_SIZE=10     # Conexiones del pool de PostgreSQL
# COOKIE_SECURE=true        # Fuerza (true/false) el atributo Secure de la cookie

# --- v1.1 · Zona horaria para plazos e informes (opcional) ---
# APP_TIMEZONE="Europe/Madrid"
# LOG_RETENTION_DAYS=7       # Días que se conservan los logs de Administración

# --- v1.1 · Google Docs / Sheets (opcional) ---
# OAuth de Google Cloud (tipo «Aplicación web»). URI de redirección autorizada:
#   <APP_URL>/api/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Opcional: solo permite cuentas de este dominio de Google Workspace.
# GOOGLE_WORKSPACE_DOMAIN="tu-dominio.com"
# Con dominio configurado, cada archivo nuevo se comparte con todo el dominio con este rol
# (writer | commenter | reader | none). Por defecto: writer.
# GOOGLE_SHARE_ROLE="writer"

# --- Iniciar sesión con Google y verificación en dos pasos (opcional) ---
# Con GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET y APP_URL, la pantalla de acceso muestra «Iniciar sesión con Google»
# (solo entra quien ya tiene cuenta). Añade esta URI de redirección autorizada al cliente OAuth, ADEMÁS de la de Drive:
#   <APP_URL>/api/auth/google/callback
# Solo con Google: desactiva el acceso con contraseña para todos (sin Google configurado no tiene efecto).
# AUTH_GOOGLE_ONLY=true
# Acceso de emergencia: con AUTH_GOOGLE_ONLY, los administradores siguen pudiendo entrar con contraseña (+ segundo paso).
# AUTH_ALLOW_ADMIN_PASSWORD=true
# La verificación en dos pasos (app TOTP o código por email) es obligatoria para administradores con contraseña y
# opcional para el resto; el código por email necesita SMTP. Sus secretos se cifran con una clave derivada de SESSION_SECRET.

# --- v1.1 · Avisos por email (opcional) ---
# Ejemplo con Google Workspace + contraseña de aplicación:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="avisos@tu-dominio.com"
# SMTP_PASS=""
# SMTP_FROM="Pizarro <avisos@tu-dominio.com>"
# Con SMTP configurado, las cuentas se aseguran por email: invitaciones, «¿Olvidaste tu contraseña?»,
# confirmación de cambios de contraseña y de email, y aviso de inicios de sesión desde dispositivos nuevos.
# Los enlaces usan APP_URL. Sin SMTP todo eso se desactiva (el admin da una clave inicial y la persona la cambia al entrar).
# SOLO para desarrollo y pruebas, NUNCA en producción: si se define, cada email se guarda como un fichero JSON
# en esta carpeta en vez de enviarse (y se considera que el email está activo).
# MAIL_OUTBOX_DIR="/ruta/absoluta/a/outbox"

# --- v1.1 · Avisos por WhatsApp (opcional, WhatsApp Cloud API de Meta) ---
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE_NAME="mencion_tablon"
# WHATSAPP_TEMPLATE_LANG="es"
# WHATSAPP_API_VERSION="v23.0"
