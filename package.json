{
  "name": "pizarro",
  "version": "1.73.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack && node scripts/postbuild.mjs && npm run build:boot",
    "start": "node --env-file-if-exists=.env --env-file=scripts/server.env scripts/start-local.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:db": "node scripts/test-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "changelog:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-changelog.ts",
    "version:bump": "node scripts/version-bump.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "docs:pdf": "node scripts/build-manual-pdf.mjs",
    "check": "npm run lint && npm run typecheck && npm run i18n:check && npm test",
    "build:boot": "node scripts/build-boot.mjs",
    "backup:restore": "node --env-file-if-exists=.env --import tsx scripts/restore.ts",
    "keys:rotate": "node --env-file-if-exists=.env --import tsx scripts/rotate-keys.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:unused": "node scripts/i18n-unused.mjs",
    "license:sync": "node scripts/license-sync.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "4.9.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-code": "3.34.0",
    "@tiptap/extension-code-block": "3.34.0",
    "@tiptap/extension-paragraph": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-mention": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "bcryptjs": "3.0.3",
    "lucide-react": "1.74.0",
    "marked": "18.2.1",
    "modern-screenshot": "4.7.0",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.65.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "@tiptap/markdown": {
      "marked": "$marked"
    }
  }
}
