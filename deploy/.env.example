# ---------------------------------------------------------------------------
# Pizarro en un servidor propio (Docker Compose). Lo normal es ejecutar ./install.sh en esta carpeta:
# crea el .env, genera los secretos y arranca. A mano:  cp .env.example .env  y rellénalo
# (los valores marcados GENERAR se crean con el comando indicado; ver docs/INSTALL.md).
# NUNCA compartas ni subas el .env: contiene los secretos de tu instalación.
# ---------------------------------------------------------------------------

# --- Imprescindibles ---------------------------------------------------------

# Dominio público que apunta a este servidor (registro DNS A/AAAA). Caddy pide el certificado HTTPS solo.
# Solo red local, sin dominio ni HTTPS: DOMAIN=":80" y APP_URL="http://<ip-del-servidor>".
DOMAIN="pizarro.example.com"

# URL pública de la app (la que escribe la gente en el navegador). Con https:// la cookie se marca Secure.
APP_URL="https://pizarro.example.com"

# Contraseña de la base de datos (solo la usan los contenedores entre sí).
# GENERAR (install.sh lo hace): openssl rand -hex 24      (hexadecimal: no da problemas dentro de la URL de conexión)
POSTGRES_PASSWORD=""

# Secreto de las sesiones. Si se cambia, todos tienen que volver a entrar (nada más, si defines las dos siguientes).
# GENERAR: openssl rand -base64 48
SESSION_SECRET=""

# Recomendadas: claves separadas para enlaces/códigos de recuperación (TOKEN_SECRET) y para cifrar los secretos del
# segundo paso y los tokens de Google (ENCRYPTION_KEY). Vacías = se usa SESSION_SECRET (y entonces cambiarla obliga a
# configurar de nuevo el segundo paso y reconectar Google). Cómo rotarlas: docs/MANUAL.md, 4.4.
# Guárdalas también FUERA del servidor, como SESSION_SECRET y BACKUP_KEY.
# GENERAR (cada una): openssl rand -base64 48
TOKEN_SECRET=""
ENCRYPTION_KEY=""
# Solo durante una rotación (la clave anterior): TOKEN_SECRET_PREVIOUS="" / ENCRYPTION_KEY_PREVIOUS=""

# Clave de las copias de seguridad diarias (cifradas, en el volumen de subidas).
# Guárdala también FUERA del servidor (gestor de contraseñas): sin ella las copias no se pueden leer.
# GENERAR: openssl rand -base64 32
BACKUP_KEY=""

# Primer arranque: por defecto NO hay que poner nada aquí. Con la base de datos vacía, la app imprime en su log
# un código de un solo uso y el asistente web (<APP_URL>/setup) pide organización, idioma, zona horaria y el
# primer administrador. Opcional: SETUP_TOKEN (mínimo 8 caracteres) es un código fijo que el asistente también acepta.
# SETUP_TOKEN=""

# Destino externo de las copias (muy recomendado: el volumen guarda a la vez los datos y sus copias).
# Almacenamiento S3 compatible (Cloudflare R2, Backblaze B2, MinIO…); ver docs/INSTALL.md, sección 4.1.
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_REGION=""
BACKUP_S3_PREFIX="pizarro"
# Y/o una carpeta montada en el contenedor (compose.override.yml; sección 4.2), p. ej. /copias-externas.
BACKUP_EXTERNAL_DIR=""
# Sin definir: la copia local incluye los ficheros solo si no hay destino externo. 1 o 0 lo fuerzan.
BACKUP_LOCAL_FILES=""
# 1: detiene las copias automáticas (p. ej. mientras se restaura tras perder datos; sección 6.3). Quítala al terminar.
# BACKUP_PAUSE=1


# Alternativa sin asistente (Railway, instalaciones automatizadas): si defines SEED_ADMIN_EMAIL y SEED_ADMIN_PASSWORD,
# el administrador se crea al arrancar con la base de datos vacía y el asistente queda desactivado.
# Después de entrar y cambiar la contraseña, borra SEED_ADMIN_PASSWORD.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_NAME="Administrador"

# Zona horaria de la app (plazos, «hoy», informes y fechas en el navegador). Opcional: si la defines, manda sobre la
# que se elija en el asistente (y este ya no deja cambiarla). Cambiarla solo exige reiniciar. Sin ella: Europe/Madrid.
# APP_TIMEZONE="Europe/Madrid"

# --- Recursos (opcional; valores pensados para un servidor de 2 GB) -------------
# APP_MEM_LIMIT=1g           # Memoria máxima del contenedor de la app
# APP_HEAP_MB=640            # Montón de Node (--max-old-space-size); déjalo por debajo de APP_MEM_LIMIT
# POSTGRES_MEM_LIMIT=512m    # Memoria máxima de PostgreSQL
# CADDY_MEM_LIMIT=128m       # Memoria máxima de Caddy

# --- Salud y errores (opcional) ------------------------------------------------
# HEALTH_MIN_FREE_MB=200     # /api/health falla (503) si queda menos espacio libre en el disco de subidas; 0 = no comprobar
# EXIT_ON_UNCAUGHT_EXCEPTION=1  # Ya lo fija compose.yml: una excepción no capturada reinicia la app; 0 = solo registrarla

# --- Límites (opcional) ---------------------------------------------------------
# MAX_USERS=10                       # Máximo de usuarios activos
# MAX_UPLOAD_MB=                     # Tope del servidor para un adjunto (MB); el real lo fija cada proyecto (20 MB por defecto, hasta 100)
# UPLOAD_QUOTA_MB_PER_PROJECT=10240  # Cuota de adjuntos por proyecto (MB; 10 GB por defecto)
# UPLOAD_QUOTA_MB_TOTAL=             # Cuota total de adjuntos (MB); vacío = sin límite
# LOG_RETENTION_DAYS=7               # Días que se conservan los logs de Administración
# DATABASE_POOL_SIZE=10              # Conexiones de la app a PostgreSQL
# DATABASE_CONNECT_TIMEOUT_MS=20000  # Tope (ms) para conectar con PostgreSQL antes de dar error
# TRUST_PROXY=0                      # Solo si publicas el puerto 3000 sin el Caddy incluido: no fiarse de X-Real-IP
# LIVE_REFRESH_JITTER_MS=2000        # Espera máxima (ms, al azar) para recargar el tablero tras un cambio ajeno; 0 = al momento

# --- Email (opcional, muy recomendable) ------------------------------------------
# Sin SMTP no hay invitaciones por email ni «¿Olvidaste tu contraseña?».
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=465
# SMTP_USER="avisos@example.com"
# SMTP_PASS=""
# SMTP_FROM="Pizarro <avisos@example.com>"

# --- Google Docs/Sheets e inicio de sesión con Google (opcional) -------------------
# URIs de redirección autorizadas en el cliente OAuth: <APP_URL>/api/google/callback y <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_WORKSPACE_DOMAIN="example.com"
# GOOGLE_SHARE_ROLE="writer"
# AUTH_GOOGLE_ONLY=true
# AUTH_ALLOW_ADMIN_PASSWORD=true

# --- Avisos por Telegram y WhatsApp (opcional) ------------------------------------
# Lo normal es configurarlos en Administración → Ajustes → «Avisos por Telegram y WhatsApp» (guías en docs/guias/).
# Telegram no necesita variables. Para WhatsApp, lo guardado en Ajustes manda campo a campo y estas variables rellenan
# lo que no se haya guardado (compatibilidad con instalaciones anteriores). Plantilla por defecto: aviso_pizarro. Si el
# nombre sale de WHATSAPP_TEMPLATE_NAME (o es mencion_pizarro), se usa el formato antiguo de 4 variables y solo
# menciones, hasta que se escribe el nombre en Ajustes (docs/guias/whatsapp.md).
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE_NAME="aviso_pizarro"
# WHATSAPP_TEMPLATE_LANG="es"
# WHATSAPP_API_VERSION="v23.0"

# --- Imagen (opcional) --------------------------------------------------------------
# Por defecto se descarga la imagen publicada ghcr.io/pla87/pizarro:latest (no se construye nada aquí).
# PIZARRO_IMAGE=ghcr.io/pla87/pizarro:1.38.0  # Fija una versión (install.sh --version X.Y.Z lo escribe solo) o usa tu registro
# COMPOSE_FILE="compose.yml:compose.build.yml"  # Construir la imagen en este servidor (install.sh --build); ver docs/INSTALL.md
# GIT_SHA=                   # Solo al construir: commit del código, para el identificador de versión

# --- Aviso de versión nueva (opcional) ---------------------------------------------
# Pizarro consulta GitHub como mucho cada 12 h para avisar a los administradores de una versión nueva.
# No envía datos de tu instalación. UPDATE_CHECK=0 lo desactiva.
# UPDATE_CHECK=0

# --- Rol de la base de datos de la app (lo rellena install.sh en instalaciones nuevas) ---
# APP_DB_USER=pizarro_app      # Sin superusuario, con CREATEDB. Vacio = la app usa el superusuario "pizarro"
# APP_DB_PASSWORD=
