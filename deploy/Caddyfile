# Caddy delante de Pizarro: HTTPS automático (Let's Encrypt) para el dominio de DOMAIN y proxy a la app.
# Con DOMAIN=":80" sirve solo HTTP (red local, sin certificado); ver docs/INSTALL.md.

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000 {
		# La app toma la IP del cliente de X-Real-IP: se sobrescribe siempre para que el cliente no pueda inventarla.
		header_up X-Real-IP {remote_host}
	}

	# Registro de accesos sin direcciones: la ruta de una petición puede llevar un token (calendario suscrito
	# /api/calendar/<token>.ics, /reset/<token>, /confirm/<token>, /login/verify?token=…), y la cabecera Referer
	# y la Location de una redirección, lo mismo (la app manda Referrer-Policy: same-origin, así que dentro del
	# propio sitio el Referer va completo). Se siguen registrando el método, el host, el estado, los bytes y el tiempo
	# de cada petición. Cookie y Authorization ya salen ocultas por defecto en Caddy.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri delete
				request>headers>Referer delete
				# El secreto del webhook de Telegram: con él se podrían falsificar avisos al bot.
				request>headers>X-Telegram-Bot-Api-Secret-Token delete
				resp_headers>Location delete
			}
		}
	}
}
