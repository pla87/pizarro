// Esquema de datos de Pizarro. Ver docs/MANUAL.md para el modelo completo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

/// Rol funcional de una columna. Como máximo una columna por proyecto puede
/// tener cada rol distinto de NONE (índice único parcial en la migración).
enum ColumnRole {
  NONE
  NEXT_RELEASE
  IN_PRODUCTION
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(MEMBER)
  active         Boolean   @default(true)
  /// Aspecto de las tarjetas: franja de color a la izquierda o tarjeta entera teñida.
  cardStyle      CardStyle @default(STRIPE)
  /// Tema de la interfaz: SYSTEM sigue al sistema operativo.
  theme          Theme     @default(SYSTEM)
  /// Color de acento de la interfaz (BLUE es el original).
  accent         Accent    @default(BLUE)
  /// Idioma de la interfaz.
  locale         Locale    @default(ES)
  /// Al cerrar sesión se borran los borradores locales de tareas (localStorage) de este navegador.
  clearDraftsOnLogout Boolean @default(false)
  /// Cómo se editan las descripciones: escribiendo Markdown o con barra de formato.
  editorMode     EditorMode @default(WYSIWYG)
  /// Preferencias de aviso de menciones.
  notifyEmail    Boolean   @default(true)
  notifyWhatsapp Boolean   @default(false)
  /// Teléfono en formato E.164 (+34600111222).
  whatsappPhone  String?
  /// Avisos por email de los demás tipos (los avisos en la app se crean siempre).
  notifyAssignedEmail Boolean @default(false)
  notifyDueEmail      Boolean @default(false)
  notifyCommentEmail  Boolean @default(false)
  /// Resumen diario por email: activado, hora local de la app (0-23) y cuándo se envió el último.
  dailyDigest    Boolean   @default(false)
  digestHour     Int       @default(8)
  lastDigestAt   DateTime?
  /// Obliga a elegir una contraseña nueva antes de usar la app (alta con clave inicial o cambio forzado por un admin).
  mustChangePassword Boolean @default(false)
  /// Identificador estable («sub») de su cuenta de Google, guardado en el primer «Iniciar sesión con Google».
  googleSub      String?   @unique
  /// Verificación en dos pasos para el acceso con contraseña (null = desactivada).
  twoFactorMethod TwoFactorMethod?
  /// Secreto TOTP cifrado (AES-GCM); solo con método TOTP.
  totpSecretEnc  String?
  /// Último paso de 30 s aceptado: impide reutilizar un código TOTP.
  totpLastStep   Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions          Session[]
  authTokens        AuthToken[]
  knownDevices      KnownDevice[]
  recoveryCodes     RecoveryCode[]
  loginChallenges   LoginChallenge[]
  memberships       ProjectMember[]
  projectPicks      AdminProjectPick[]
  privateProjects   Project[]         @relation("PrivateProjects")
  assignedTasks     Task[]            @relation("TaskAssignee")
  createdTasks      Task[]            @relation("TaskCreator")
  attachments       TaskAttachment[]
  releases          Release[]
  googleAccount     GoogleAccount?
  releaseTemplates  ReleaseTemplate[]
  taskLinks         TaskLink[]
  comments          TaskComment[]
  notifications     Notification[]    @relation("NotificationRecipient")
  notificationsSent Notification[]    @relation("NotificationActor")
  undoEntries       UndoEntry[]
  followedTasks     TaskFollower[]
}

model Session {
  /// HMAC-SHA256 del token de la cookie; el token en claro nunca se guarda.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Última actividad (se actualiza como mucho cada 5 minutos).
  lastSeenAt DateTime @default(now())
  /// Navegador que abrió la sesión (truncado) e IP de ese momento.
  userAgent String?
  ip        String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  PASSWORD_CHANGE
  EMAIL_CHANGE
  INVITE
}

/// Enlace de un solo uso enviado por email (restablecer o confirmar contraseña, confirmar email, invitación).
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  /// HMAC-SHA256 del token del enlace; el token en claro nunca se guarda.
  tokenHash String           @unique
  /// Datos pendientes de confirmar (hash de la contraseña nueva, email nuevo); nunca texto en claro.
  data      Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Dispositivos desde los que ya se ha iniciado sesión (para avisar de accesos nuevos). Solo se guarda el hash de la cookie.
model KnownDevice {
  id         String   @id @default(cuid())
  userId     String
  deviceHash String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// «Recordar este dispositivo»: hasta esta fecha no se pide el segundo paso en este navegador.
  trustedUntil DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@index([lastSeenAt])
}

enum TwoFactorMethod {
  TOTP
  EMAIL
}

enum LoginChallengeKind {
  /// Contraseña correcta, falta el segundo paso.
  LOGIN
  /// Administrador sin método: debe configurarlo antes de entrar.
  SETUP
  /// Alta o cambio de método desde «Mi perfil» (sin cookie; ligado a la sesión).
  ENROLL
}

/// Códigos de recuperación de un solo uso de la verificación en dos pasos. Solo se guarda su HMAC.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Estado pendiente de un inicio de sesión o de un alta de 2FA. La cookie solo lleva el token; aquí queda su HMAC.
model LoginChallenge {
  id                String             @id @default(cuid())
  userId            String
  kind              LoginChallengeKind
  tokenHash         String             @unique
  /// Método elegido (en altas) para el que se espera el código.
  method            TwoFactorMethod?
  /// Secreto TOTP nuevo, cifrado, aún sin confirmar.
  pendingSecretEnc  String?
  /// HMAC del código de email vigente (un solo uso) y su caducidad.
  codeHash          String?
  codeExpiresAt     DateTime?
  attempts          Int                @default(0)
  /// El código del alta ya se ha comprobado y se han mostrado los códigos de recuperación.
  confirmed         Boolean            @default(false)
  /// Ruta a la que volver tras entrar.
  next              String?
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// Proyecto privado: solo lo ven y usan sus miembros (ProjectMember), ni siquiera los administradores.
  /// Se marca aparte de privateOwnerId para que borrar a quien lo creó no lo haga público.
  isPrivate   Boolean  @default(false)
  /// Quien creó el proyecto privado (informativo; pasa a null si se borra ese usuario).
  privateOwnerId String?
  /// Tamaño máximo (MB) de cada paquete ZIP de adjuntos de una release (se arma en memoria). Nunca menor que taskAttachMaxMb.
  releaseZipMaxMb Int    @default(80)
  /// Tamaño máximo (MB) de la suma de adjuntos de una tarea.
  taskAttachMaxMb Int    @default(80)
  position    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      ProjectMember[]
  adminPicks   AdminProjectPick[]
  columns      Column[]
  tasks        Task[]
  labels       Label[]
  releases     Release[]
  deliverables Deliverable[]
  kinds        TaskKind[]
  hiddenKinds  ProjectHiddenKind[]
  undoEntries  UndoEntry[]
  reportSchedule ReportSchedule?
  privateOwner User?           @relation("PrivateProjects", fields: [privateOwnerId], references: [id], onDelete: SetNull)

  @@index([position])
}

/// Usuarios asignados al proyecto. En uno de equipo, los no administradores solo lo ven si figuran aquí; en uno privado, solo sus miembros.
model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// Proyectos de equipo (no privados) en los que trabaja un administrador: solo esos salen en sus selectores y menús.
/// Los administradores pueden abrir cualquier proyecto no privado aunque no lo hayan elegido.
model AdminProjectPick {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Column {
  id        String     @id @default(cuid())
  projectId String
  name      String
  position  Float
  role      ColumnRole @default(NONE)
  /// Las tarjetas de esta columna cuentan como terminadas (informe y plazos).
  isDone    Boolean    @default(false)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, position])
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Task {
  id            String    @id @default(cuid())
  projectId     String
  columnId      String
  title         String
  description   String    @default("")
  kindId        String
  color         String?
  linkUrl       String?
  position      Float
  assigneeId    String?
  createdById   String?
  /// Fecha límite (solo día).
  dueDate       DateTime? @db.Date
  deliverableId String?
  archivedAt    DateTime?
  /// Columna en la que estaba al archivarse (sin clave foránea: la columna puede borrarse después).
  archivedFromColumnId String?
  /// Tarea fija de la columna «Siguiente salto»: se incluye en cada release y no sale de la columna al desplegar.
  evergreen     Boolean   @default(false)
  /// Cadencia de una tarea fija: 1 = todas las releases, 2 = las pares, 3 = múltiplos de 3.
  evergreenEvery Int      @default(1)
  /// Último cambio de contenido (título, descripción, tipo…) y quién lo hizo: detecta ediciones simultáneas.
  contentUpdatedAt   DateTime?
  contentUpdatedById String?
  /// Repetición: al terminarse o archivarse se crea la siguiente aparición (ver lib/recurrence.ts).
  recurrence    Recurrence @default(NONE)
  /// Semanal: día de la semana (1 = lunes … 7 = domingo). Mensual: día del mes (1-31; en meses cortos, el último día).
  recurrenceDay Int?
  /// Tarea de la que salió esta aparición. Único: de una tarea solo puede salir una siguiente (idempotencia).
  recurrenceFromId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  recurrenceFrom Task?           @relation("TaskRecurrence", fields: [recurrenceFromId], references: [id], onDelete: SetNull)
  recurrenceNext Task?           @relation("TaskRecurrence")
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column        Column           @relation(fields: [columnId], references: [id], onDelete: Restrict)
  kind          TaskKind         @relation(fields: [kindId], references: [id], onDelete: Restrict)
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  deliverable   Deliverable?     @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  links         TaskLink[]
  comments      TaskComment[]
  notifications Notification[]
  createdBy     User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  subtasks      Subtask[]
  attachments   TaskAttachment[]
  labels        TaskLabel[]
  releases      ReleaseTask[]
  followers     TaskFollower[]
  events        TaskEvent[]

  @@index([columnId, position])
  @@index([projectId, archivedAt])
  @@index([assigneeId, archivedAt])
  @@index([deliverableId])
  @@index([kindId])
  @@index([projectId, dueDate])
  @@index([createdAt])
  @@index([createdById])
}

model Label {
  id        String      @id @default(cuid())
  projectId String
  name      String
  color     String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([projectId, name])
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model Subtask {
  id       String  @id @default(cuid())
  taskId   String
  title    String
  done     Boolean @default(false)
  position Float
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  originalName String
  /// Tipo MIME del fichero guardado (image/webp para las imágenes, que se convierten).
  mimeType     String   @default("image/webp")
  /// Las imágenes se convierten a WebP y tienen miniatura; el resto se guarda tal cual.
  isImage      Boolean  @default(true)
  width        Int?
  height       Int?
  size         Int
  createdById  String?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([createdById])
}

model Release {
  id          String        @id @default(cuid())
  projectId   String
  /// Número de la release dentro del proyecto (1, 2, 3…): da el prefijo de los códigos (R32M4).
  number      Int
  title       String
  content     String
  createdById String?
  deployedAt  DateTime      @default(now())
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks       ReleaseTask[]
  attachments ReleaseAttachment[]
  /// Trabajo pendiente de copiar los adjuntos al histórico ({items, allowed, userId, userName}); se limpia al terminar.
  /// Si el servidor se reinicia a mitad, el arranque lo retoma.
  attachmentsPending Json?

  @@index([projectId, deployedAt])
  @@index([createdById])
  @@unique([projectId, number])
}

/// Copia reducida de un adjunto incluido en una release, con su nombre ya renombrado
/// (`F1_captura.webp`). Se guarda en UPLOAD_DIR/releases/<id>.webp y sobrevive al borrado de la tarea.
model ReleaseAttachment {
  id        String   @id @default(cuid())
  releaseId String
  fileName  String
  size      Int
  /// Las copias de imágenes se conservan; las de otros ficheros se borran a los 7 días.
  isImage   Boolean  @default(true)
  position  Int
  createdAt DateTime @default(now())
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, fileName])
  @@index([releaseId])
}

/// Instantánea de cada tarea incluida en una release (se conserva aunque la tarea se borre).
model ReleaseTask {
  id        String  @id @default(cuid())
  releaseId String
  taskId    String?
  title     String
  /// Nombre del tipo en el momento del despliegue.
  kindName  String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([releaseId])
  @@index([taskId])
}

/// Historial de versiones de la propia aplicación, sincronizado desde changelog.json.
model AppVersionLog {
  id         String   @id @default(cuid())
  version    String   @unique
  releasedAt DateTime
  summary    String   @default("")
  /// { "nuevas": string[], "mejoras": string[], "correcciones": string[], "tecnicos": string[] }
  changes    Json
  /// Versión en inglés (vacía = se muestra la española).
  summaryEn  String   @default("")
  changesEn  Json?
  syncedAt   DateTime @updatedAt
}

/// Entregable o hito del proyecto: agrupa tarjetas y tiene fecha objetivo.
model Deliverable {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String    @default("")
  dueDate     DateTime? @db.Date
  position    Float
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, position])
  @@index([projectId, dueDate])
}

enum TaskLinkKind {
  GOOGLE_DOC
  GOOGLE_SHEET
}

/// Documento externo enlazado a una tarjeta (creado con @docs / @sheets).
model TaskLink {
  id          String       @id @default(cuid())
  taskId      String
  kind        TaskLinkKind
  title       String
  url         String
  externalId  String?
  createdById String?
  createdAt   DateTime     @default(now())
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([createdById])
}

/// Cuenta de Google conectada por OAuth (permiso drive.file). Tokens cifrados con AES-256-GCM.
model GoogleAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  email             String
  refreshTokenEnc   String
  accessTokenEnc    String?
  accessTokenExpiry DateTime?
  scope             String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  /// Las menciones se guardan como @[Nombre](user:ID).
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  /// Comentario al que responde (un solo nivel: siempre el comentario raíz).
  parentId  String?
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent    TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   TaskComment[] @relation("CommentReplies")

  @@index([taskId, createdAt])
  @@index([parentId])
  @@index([createdAt])
  @@index([authorId])
}

enum NotificationType {
  MENTION
  ASSIGNED
  DUE_CHANGED
  COMMENT
  REPLY
}

/// Seguimiento de una tarea. Se sigue implícitamente al crearla, tener asignada, comentar o ser mencionado
/// (se guarda la fila); `muted` = la persona ha dejado de seguirla y no recibe sus avisos.
model TaskFollower {
  taskId    String
  userId    String
  muted     Boolean  @default(false)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

/// Historial de cambios de una tarea (se conserva 365 días, a diferencia de los logs).
model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  projectId String
  userId    String?
  /// Nombre en el momento del cambio.
  userName  String
  /// create, update, move, done, archive, restore, subtask, comment, other…
  code      String
  /// Etiqueta traducible (ver undo-label.ts): se traduce al idioma de quien la lee.
  label     String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([projectId, code, createdAt])
  @@index([createdAt])
}

/// Informe PDF semanal por email de un proyecto.
model ReportSchedule {
  projectId   String    @id
  enabled     Boolean   @default(true)
  recipient   String
  /// Día de la semana ISO (1 = lunes … 7 = domingo) y hora local de la app (0-23).
  weekday     Int       @default(1)
  hour        Int       @default(8)
  lastSentAt  DateTime?
  createdById String?
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Registro de actividad de la aplicación (se conserva LOG_RETENTION_DAYS días, 7 por defecto).
model AppLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// info | warn | error
  level      String
  /// auth, page, action, api, notify, system…
  category   String
  /// Nombre del evento, p. ej. «tasks.createTask» o «auth.login».
  action     String
  message    String   @default("")
  userId     String?
  /// Nombre en el momento del evento (se conserva aunque el usuario cambie o se borre).
  userName   String?
  projectId  String?
  /// Proyecto privado afectado (si lo es): quien no es miembro solo ve hora y usuario. Se guarda aparte de
  /// projectId para seguir ocultando el detalle aunque el proyecto se borre.
  privateProjectId String?
  path       String?
  durationMs Int?
  ip         String?
  details    Json?

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  actorId        String?
  type           NotificationType @default(MENTION)
  taskId         String?
  excerpt        String           @default("")
  readAt         DateTime?
  emailSentAt    DateTime?
  whatsappSentAt DateTime?
  deliveryError  String?
  createdAt      DateTime         @default(now())
  user           User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([taskId])
  @@index([readAt, createdAt])
  @@index([actorId])
}

/// Tipo de tarea configurable por los administradores (cada uno es una sección de la release).
/// Tipo de tarea. Sin projectId es general (todos los proyectos); con projectId, exclusivo de ese proyecto.
/// Nombres únicos sin distinguir mayúsculas: entre los generales y dentro de cada proyecto (índices parciales en la migración v1_4).
model TaskKind {
  id        String   @id @default(cuid())
  name      String
  color     String
  position  Float
  createdAt DateTime @default(now())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Automatización: al elegir el tipo, la tarea toma este título (vacío = no cambia).
  titleTemplate       String @default("")
  /// Automatización: texto con el que empieza la descripción (vacío = no cambia).
  descriptionTemplate String @default("")
  /// Automatización: subtareas que se añaden al elegir el tipo al crear una tarea (una por elemento, máx. 50).
  subtaskTemplate     String[] @default([])
  tasks     Task[]
  hiddenIn  ProjectHiddenKind[]

  @@index([projectId])
}

/// Tipo general que un proyecto ha decidido no usar.
model ProjectHiddenKind {
  projectId String
  kindId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      TaskKind @relation(fields: [kindId], references: [id], onDelete: Cascade)

  @@id([projectId, kindId])
  @@index([kindId])
}

/// Plantilla para crear proyectos (la definen los administradores).
model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// [{ name, role, isDone }] en orden.
  columns     Json
  /// Tipos propios del proyecto: [{ name, color, titleTemplate, descriptionTemplate }].
  kinds       Json     @default("[]")
  /// Nombres de los tipos generales que el proyecto NO usará.
  hiddenGeneralKinds Json @default("[]")
  /// Oculta todos los tipos generales (plantillas ajenas al software).
  hideAllGeneralKinds Boolean @default(false)
  /// [{ name, color }]
  labels      Json     @default("[]")
  position    Float    @default(0)
  /// Clave estable de las plantillas incluidas de serie (src/lib/builtin-templates.ts); null en las propias.
  builtinKey  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Plantillas de serie ya sembradas alguna vez: si el administrador borra una, no se recrea sola al arrancar.
model BuiltinTemplateSeeded {
  key      String   @id
  seededAt DateTime @default(now())
  /// Huella del contenido canónico aplicado por última vez a la plantilla; null en las sembradas antes de existir este campo.
  appliedHash String?
}

enum CardStyle {
  STRIPE
  FILLED
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum Accent {
  BLUE
  FOREST
  SIENNA
  MUSTARD
  MONO
  EVA
}

enum Locale {
  ES
  EN
}

enum EditorMode {
  MARKDOWN
  WYSIWYG
}

enum TemplateKind {
  HEADER
  FOOTER
}

/// Cabeceras y pies de release de cada usuario (puede tener varios de cada).
model ReleaseTemplate {
  id        String       @id @default(cuid())
  userId    String
  kind      TemplateKind
  name      String
  content   String
  position  Float
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, position])
}

/// Pila a la que pertenece una entrada: deshacer o rehacer.
enum UndoKind {
  UNDO
  REDO
}

/// Acción deshacible de un usuario en un proyecto (se guardan las 10 últimas de cada pila). `ops` son las
/// operaciones inversas, que se aplican en orden inverso al deshacer (ver src/lib/undo.ts).
model UndoEntry {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  /// Tarea a la que afecta (si es solo una): contexto del deshacer con la tarea abierta.
  taskId    String?
  /// UNDO: lo que hace «Deshacer». REDO: lo que rehace una acción ya deshecha (se vacía con una acción nueva).
  kind      UndoKind @default(UNDO)
  label     String
  ops       Json
  /// Huella de lo que tocan las ops justo después de crear la entrada contraria (rehacer/deshacer): si cambia, alguien más lo modificó y no se aplica.
  fingerprint String?
  /// UNDO: ids de las entradas de historial (TaskEvent) que registró la acción; al deshacer se borran.
  eventIds  String[] @default([])
  /// REDO: copia de las entradas de historial borradas al deshacer, para recrearlas al rehacer.
  events    Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId, kind, createdAt])
  @@index([userId, taskId, createdAt])
  @@index([projectId])
  @@index([createdAt])
}
