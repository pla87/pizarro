// Esquema de datos de Pizarro. Ver docs/MANUAL.md para el modelo completo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

/// Rol funcional de una columna. Como máximo una columna por proyecto puede
/// tener cada rol distinto de NONE (índice único parcial en la migración).
enum ColumnRole {
  NONE
  NEXT_RELEASE
  IN_PRODUCTION
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(MEMBER)
  active         Boolean   @default(true)
  /// Aspecto de las tarjetas: franja de color a la izquierda o tarjeta entera teñida.
  cardStyle      CardStyle @default(STRIPE)
  /// Tema de la interfaz: SYSTEM sigue al sistema operativo.
  theme          Theme     @default(SYSTEM)
  /// Preferencias de aviso de menciones.
  notifyEmail    Boolean   @default(true)
  notifyWhatsapp Boolean   @default(false)
  /// Teléfono en formato E.164 (+34600111222).
  whatsappPhone  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions          Session[]
  memberships       ProjectMember[]
  privateProjects   Project[]         @relation("PrivateProjects")
  assignedTasks     Task[]            @relation("TaskAssignee")
  createdTasks      Task[]            @relation("TaskCreator")
  attachments       TaskAttachment[]
  releases          Release[]
  googleAccount     GoogleAccount?
  releaseTemplates  ReleaseTemplate[]
  taskLinks         TaskLink[]
  comments          TaskComment[]
  notifications     Notification[]    @relation("NotificationRecipient")
  notificationsSent Notification[]    @relation("NotificationActor")
  undoEntries       UndoEntry[]
}

model Session {
  /// HMAC-SHA256 del token de la cookie; el token en claro nunca se guarda.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// false: visible para todos los usuarios. true: solo admins y miembros explícitos.
  restricted  Boolean  @default(false)
  /// Proyecto privado: solo lo ve y lo usa este usuario (ni siquiera los demás administradores).
  privateOwnerId String?
  /// Desde cuándo está bloqueado (su dueño se desactivó o dejó de ser admin). Se borra al borrar al dueño.
  privateBlockedAt DateTime?
  position    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      ProjectMember[]
  columns      Column[]
  tasks        Task[]
  labels       Label[]
  releases     Release[]
  deliverables Deliverable[]
  kinds        TaskKind[]
  hiddenKinds  ProjectHiddenKind[]
  undoEntries  UndoEntry[]
  privateOwner User?           @relation("PrivateProjects", fields: [privateOwnerId], references: [id], onDelete: SetNull)

  @@index([position])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Column {
  id        String     @id @default(cuid())
  projectId String
  name      String
  position  Float
  role      ColumnRole @default(NONE)
  /// Las tarjetas de esta columna cuentan como terminadas (informe y plazos).
  isDone    Boolean    @default(false)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, position])
}

model Task {
  id            String    @id @default(cuid())
  projectId     String
  columnId      String
  title         String
  description   String    @default("")
  kindId        String
  color         String?
  linkUrl       String?
  position      Float
  assigneeId    String?
  createdById   String?
  /// Fecha límite (solo día).
  dueDate       DateTime? @db.Date
  deliverableId String?
  archivedAt    DateTime?
  /// Columna en la que estaba al archivarse (sin clave foránea: la columna puede borrarse después).
  archivedFromColumnId String?
  /// Tarea fija de la columna «Siguiente salto»: se incluye en cada release y no sale de la columna al desplegar.
  evergreen     Boolean   @default(false)
  /// Último cambio de contenido (título, descripción, tipo…) y quién lo hizo: detecta ediciones simultáneas.
  contentUpdatedAt   DateTime?
  contentUpdatedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column        Column           @relation(fields: [columnId], references: [id], onDelete: Restrict)
  kind          TaskKind         @relation(fields: [kindId], references: [id], onDelete: Restrict)
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  deliverable   Deliverable?     @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  links         TaskLink[]
  comments      TaskComment[]
  notifications Notification[]
  createdBy     User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  subtasks      Subtask[]
  attachments   TaskAttachment[]
  labels        TaskLabel[]
  releases      ReleaseTask[]

  @@index([columnId, position])
  @@index([projectId, archivedAt])
  @@index([assigneeId, archivedAt])
  @@index([deliverableId])
  @@index([kindId])
}

model Label {
  id        String      @id @default(cuid())
  projectId String
  name      String
  color     String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([projectId, name])
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model Subtask {
  id       String  @id @default(cuid())
  taskId   String
  title    String
  done     Boolean @default(false)
  position Float
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  originalName String
  /// Tipo MIME del fichero guardado (image/webp para las imágenes, que se convierten).
  mimeType     String   @default("image/webp")
  /// Las imágenes se convierten a WebP y tienen miniatura; el resto se guarda tal cual.
  isImage      Boolean  @default(true)
  width        Int?
  height       Int?
  size         Int
  createdById  String?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Release {
  id          String        @id @default(cuid())
  projectId   String
  title       String
  content     String
  createdById String?
  deployedAt  DateTime      @default(now())
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks       ReleaseTask[]
  attachments ReleaseAttachment[]

  @@index([projectId, deployedAt])
}

/// Copia reducida de un adjunto incluido en una release, con su nombre ya renombrado
/// (`F1_captura.webp`). Se guarda en UPLOAD_DIR/releases/<id>.webp y sobrevive al borrado de la tarea.
model ReleaseAttachment {
  id        String   @id @default(cuid())
  releaseId String
  fileName  String
  size      Int
  /// Las copias de imágenes se conservan; las de otros ficheros se borran a los 7 días.
  isImage   Boolean  @default(true)
  position  Int
  createdAt DateTime @default(now())
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
}

/// Instantánea de cada tarea incluida en una release (se conserva aunque la tarea se borre).
model ReleaseTask {
  id        String  @id @default(cuid())
  releaseId String
  taskId    String?
  title     String
  /// Nombre del tipo en el momento del despliegue.
  kindName  String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([releaseId])
  @@index([taskId])
}

/// Historial de versiones de la propia aplicación, sincronizado desde changelog.json.
model AppVersionLog {
  id         String   @id @default(cuid())
  version    String   @unique
  releasedAt DateTime
  summary    String   @default("")
  /// { "nuevas": string[], "mejoras": string[], "correcciones": string[], "tecnicos": string[] }
  changes    Json
  syncedAt   DateTime @updatedAt
}

/// Entregable o hito del proyecto: agrupa tarjetas y tiene fecha objetivo.
model Deliverable {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String    @default("")
  dueDate     DateTime? @db.Date
  position    Float
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, position])
}

enum TaskLinkKind {
  GOOGLE_DOC
  GOOGLE_SHEET
}

/// Documento externo enlazado a una tarjeta (creado con @docs / @sheets).
model TaskLink {
  id          String       @id @default(cuid())
  taskId      String
  kind        TaskLinkKind
  title       String
  url         String
  externalId  String?
  createdById String?
  createdAt   DateTime     @default(now())
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

/// Cuenta de Google conectada por OAuth (permiso drive.file). Tokens cifrados con AES-256-GCM.
model GoogleAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  email             String
  refreshTokenEnc   String
  accessTokenEnc    String?
  accessTokenExpiry DateTime?
  scope             String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  /// Las menciones se guardan como @[Nombre](user:ID).
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

enum NotificationType {
  MENTION
}

/// Registro de actividad de la aplicación (se conserva LOG_RETENTION_DAYS días, 7 por defecto).
model AppLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// info | warn | error
  level      String
  /// auth, page, action, api, notify, system…
  category   String
  /// Nombre del evento, p. ej. «tasks.createTask» o «auth.login».
  action     String
  message    String   @default("")
  userId     String?
  /// Nombre en el momento del evento (se conserva aunque el usuario cambie o se borre).
  userName   String?
  projectId  String?
  /// Dueño del proyecto privado afectado (si lo es): el resto de admins solo ve hora y usuario.
  privateOwnerId String?
  path       String?
  durationMs Int?
  ip         String?
  details    Json?

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  actorId        String?
  type           NotificationType @default(MENTION)
  taskId         String?
  excerpt        String           @default("")
  readAt         DateTime?
  emailSentAt    DateTime?
  whatsappSentAt DateTime?
  deliveryError  String?
  createdAt      DateTime         @default(now())
  user           User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Tipo de tarea configurable por los administradores (cada uno es una sección de la release).
/// Tipo de tarea. Sin projectId es general (todos los proyectos); con projectId, exclusivo de ese proyecto.
/// Nombres únicos sin distinguir mayúsculas: entre los generales y dentro de cada proyecto (índices parciales en la migración v1_4).
model TaskKind {
  id        String   @id @default(cuid())
  name      String
  color     String
  position  Float
  createdAt DateTime @default(now())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Automatización: al elegir el tipo, la tarea toma este título (vacío = no cambia).
  titleTemplate       String @default("")
  /// Automatización: texto con el que empieza la descripción (vacío = no cambia).
  descriptionTemplate String @default("")
  /// Tipo del sistema (p. ej. «Respuesta»): no se puede borrar.
  system    Boolean  @default(false)
  tasks     Task[]
  hiddenIn  ProjectHiddenKind[]

  @@index([projectId])
}

/// Tipo general que un proyecto ha decidido no usar.
model ProjectHiddenKind {
  projectId String
  kindId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      TaskKind @relation(fields: [kindId], references: [id], onDelete: Cascade)

  @@id([projectId, kindId])
  @@index([kindId])
}

/// Plantilla para crear proyectos (la definen los administradores).
model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// [{ name, role, isDone }] en orden.
  columns     Json
  /// Tipos propios del proyecto: [{ name, color, titleTemplate, descriptionTemplate }].
  kinds       Json     @default("[]")
  /// Nombres de los tipos generales que el proyecto NO usará.
  hiddenGeneralKinds Json @default("[]")
  /// [{ name, color }]
  labels      Json     @default("[]")
  position    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CardStyle {
  STRIPE
  FILLED
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum TemplateKind {
  HEADER
  FOOTER
}

/// Cabeceras y pies de release de cada usuario (puede tener varios de cada).
model ReleaseTemplate {
  id        String       @id @default(cuid())
  userId    String
  kind      TemplateKind
  name      String
  content   String
  position  Float
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, position])
}

/// Acción deshacible de un usuario en un proyecto (se guardan las 10 últimas). `ops` son las
/// operaciones inversas, que se aplican en orden inverso al deshacer (ver src/lib/undo.ts).
model UndoEntry {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  label     String
  ops       Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId, createdAt])
  @@index([createdAt])
}
