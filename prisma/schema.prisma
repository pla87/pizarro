// Esquema de datos de Tablón. Ver docs/MANUAL.md para el modelo completo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskType {
  FEATURE
  FIX
  CHORE
  REFACTOR
  HOTFIX
}

/// Rol funcional de una columna. Como máximo una columna por proyecto puede
/// tener cada rol distinto de NONE (índice único parcial en la migración).
enum ColumnRole {
  NONE
  NEXT_RELEASE
  IN_PRODUCTION
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  name                  String
  passwordHash          String
  role                  Role     @default(MEMBER)
  active                Boolean  @default(true)
  releaseHeaderTemplate String   @default("")
  releaseFooterTemplate String   @default("")
  /// Preferencias de aviso de menciones.
  notifyEmail           Boolean  @default(true)
  notifyWhatsapp        Boolean  @default(false)
  /// Teléfono en formato E.164 (+34600111222).
  whatsappPhone         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sessions          Session[]
  memberships       ProjectMember[]
  assignedTasks     Task[]           @relation("TaskAssignee")
  createdTasks      Task[]           @relation("TaskCreator")
  attachments       TaskAttachment[]
  releases          Release[]
  googleAccount     GoogleAccount?
  taskLinks         TaskLink[]
  comments          TaskComment[]
  notifications     Notification[]   @relation("NotificationRecipient")
  notificationsSent Notification[]   @relation("NotificationActor")
}

model Session {
  /// HMAC-SHA256 del token de la cookie; el token en claro nunca se guarda.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// false: visible para todos los usuarios. true: solo admins y miembros explícitos.
  restricted  Boolean  @default(false)
  position    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      ProjectMember[]
  columns      Column[]
  tasks        Task[]
  labels       Label[]
  releases     Release[]
  deliverables Deliverable[]

  @@index([position])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Column {
  id        String     @id @default(cuid())
  projectId String
  name      String
  position  Float
  role      ColumnRole @default(NONE)
  /// Las tarjetas de esta columna cuentan como terminadas (informe y plazos).
  isDone    Boolean    @default(false)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, position])
}

model Task {
  id            String    @id @default(cuid())
  projectId     String
  columnId      String
  title         String
  description   String    @default("")
  type          TaskType  @default(FEATURE)
  color         String?
  linkUrl       String?
  position      Float
  assigneeId    String?
  createdById   String?
  /// Fecha límite (solo día).
  dueDate       DateTime? @db.Date
  deliverableId String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column        Column           @relation(fields: [columnId], references: [id], onDelete: Restrict)
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  deliverable   Deliverable?     @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  links         TaskLink[]
  comments      TaskComment[]
  notifications Notification[]
  createdBy     User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  subtasks      Subtask[]
  attachments   TaskAttachment[]
  labels        TaskLabel[]
  releases      ReleaseTask[]

  @@index([columnId, position])
  @@index([projectId, archivedAt])
  @@index([assigneeId, archivedAt])
  @@index([deliverableId])
}

model Label {
  id        String      @id @default(cuid())
  projectId String
  name      String
  color     String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([projectId, name])
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model Subtask {
  id       String  @id @default(cuid())
  taskId   String
  title    String
  done     Boolean @default(false)
  position Float
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  originalName String
  width        Int
  height       Int
  size         Int
  createdById  String?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Release {
  id          String        @id @default(cuid())
  projectId   String
  title       String
  content     String
  createdById String?
  deployedAt  DateTime      @default(now())
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks       ReleaseTask[]

  @@index([projectId, deployedAt])
}

/// Instantánea de cada tarea incluida en una release (se conserva aunque la tarea se borre).
model ReleaseTask {
  id        String   @id @default(cuid())
  releaseId String
  taskId    String?
  title     String
  type      TaskType
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([releaseId])
  @@index([taskId])
}

/// Historial de versiones de la propia aplicación, sincronizado desde changelog.json.
model AppVersionLog {
  id         String   @id @default(cuid())
  version    String   @unique
  releasedAt DateTime
  summary    String   @default("")
  /// { "nuevas": string[], "mejoras": string[], "correcciones": string[], "tecnicos": string[] }
  changes    Json
  syncedAt   DateTime @updatedAt
}

/// Entregable o hito del proyecto: agrupa tarjetas y tiene fecha objetivo.
model Deliverable {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String    @default("")
  dueDate     DateTime? @db.Date
  position    Float
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, position])
}

enum TaskLinkKind {
  GOOGLE_DOC
  GOOGLE_SHEET
}

/// Documento externo enlazado a una tarjeta (creado con @docs / @sheets).
model TaskLink {
  id          String       @id @default(cuid())
  taskId      String
  kind        TaskLinkKind
  title       String
  url         String
  externalId  String?
  createdById String?
  createdAt   DateTime     @default(now())
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

/// Cuenta de Google conectada por OAuth (permiso drive.file). Tokens cifrados con AES-256-GCM.
model GoogleAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  email             String
  refreshTokenEnc   String
  accessTokenEnc    String?
  accessTokenExpiry DateTime?
  scope             String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  /// Las menciones se guardan como @[Nombre](user:ID).
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

enum NotificationType {
  MENTION
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  actorId        String?
  type           NotificationType @default(MENTION)
  taskId         String?
  excerpt        String           @default("")
  readAt         DateTime?
  emailSentAt    DateTime?
  whatsappSentAt DateTime?
  deliveryError  String?
  createdAt      DateTime         @default(now())
  user           User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
